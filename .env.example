# FirstPass — copy to .env.local and fill in. Every integration falls back to
# deterministic cached/mock data when its key is absent, so the app runs and
# demos without any of these. Add keys to make each integration go LIVE.
#
# Core (load-bearing): OPENAI_API_KEY, APS_* (DWG uploads), REDIS_URL (prod
# state), CLERK_* (accounts — every page except the landing page requires
# sign-in, and projects are scoped to the signed-in account). The rest are
# OPT-IN even with keys set — see the FIRSTPASS_* flags:
#   FIRSTPASS_BAND=1           route runs through the real Band agent room
#   FIRSTPASS_LIVE_RESEARCH=1  browse code portals live during a run (Browserbase)
#   FIRSTPASS_REDISVL=1        use the RedisVL hybrid index (default: lexical scorer)
#   FIRSTPASS_DEMO=1           force the scripted demo pipeline

# Clerk — authentication. Get keys from https://dashboard.clerk.com (this
# project is linked to app_3G0wyegTko2bScQ93SKx61lHXlD via the Clerk CLI).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# OpenAI — plan reader (vision/extraction, rule interpretation, report writing).
# The Python Band agents (src/firstpass/openai_adapter.py) run on the SAME key,
# read from firstpass.config.yaml's `openai:` block — mirror this value there.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Browserbase — corpus ingestion (scripts + Python researchers) and, with
# FIRSTPASS_LIVE_RESEARCH=1, live navigation of official permitting sites
# during a run. Keys alone no longer trigger in-run browsing (slow/flaky).
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
FIRSTPASS_LIVE_RESEARCH=

# Redis — the firm's shared brain: project state, the multi-agent blackboard
# (project:{id}:blackboard, written by the Python Band agents), the code corpus,
# and the RedisVL hybrid-search index. Standard redis:// or rediss:// URL;
# Upstash/Redis Cloud both work on Vercel. Leave blank for the in-memory fallback.
# NOTE: code retrieval defaults to the deterministic lexical scorer over the
# committed corpus. Set FIRSTPASS_REDISVL=1 (plus a Redis with the Search
# module — Redis Stack / Redis 8 / Redis Cloud — and a built index via
# scripts/index_codes_redisvl.py) to try the RedisVL hybrid index first.
REDIS_URL=
FIRSTPASS_REDISVL=

# Arize — tracing + evaluation (citation / authority / applicability / hallucination)
ARIZE_API_KEY=
ARIZE_SPACE_ID=

# Band — multi-agent message bus / activity feed. The local feed always works.
# Set BAND_API_KEY (an orchestrator agent key, band_a_...) AND FIRSTPASS_BAND=1
# to route runs through a REAL Band room: it validates /me, creates a chat,
# adds you (the human owner) and the registered research agents, and posts a
# kickoff @mention. Without FIRSTPASS_BAND=1 the scripted pipeline runs (same
# compliance results, faster, no room-orchestration failure modes).
FIRSTPASS_BAND=
# Register these External Agents at app.band.ai with these exact names; their
# ids default to the ones the room was first built with (override if you re-register):
#   - Municipal Code Researcher  (BAND_AGENT_MUNICIPAL_ID)
#   - State Code Researcher       (BAND_AGENT_STATE_ID)
#   - Code Synthesizer            (BAND_AGENT_SYNTHESIZER_ID)
BAND_API_KEY=
BAND_AGENT_MUNICIPAL_ID=
BAND_AGENT_STATE_ID=
BAND_AGENT_SYNTHESIZER_ID=
BAND_AGENT_COMPARE_ID=
BAND_AGENT_COMPARE_KEY=
# Chat 3 closeout — design fixes + permit portal research (Browserbase)
BAND_AGENT_SOLUTIONS_ID=
BAND_AGENT_SOLUTIONS_KEY=
BAND_AGENT_PERMIT_ID=
BAND_AGENT_PERMIT_KEY=
# Optional: override the Band REST endpoint for self-hosted deployments.
BAND_REST_URL=https://app.band.ai/api/v1/agent
# Legacy single-room forward fallback (used only if no room is created above).
BAND_CHAT_ID=
BAND_MENTION_ID=
BAND_MENTION_NAME=
BAND_MENTION_HANDLE=

# Autodesk Platform Services (APS) — DWG upload + Model Derivative translation.
# 2-legged (client credentials); the callback is only needed for 3-legged flows.
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_CALLBACK_URL=http://localhost:3000/api/aps/auth

# Compare Codes Band listener calls this Next.js base URL (Python firstpass-compare).
FIRSTPASS_API_URL=http://127.0.0.1:3000

# Ingest guard — POST /api/cities/ingest writes the cited building-code corpus.
# Set this in production to require an `x-ingest-secret: <value>` header on that
# endpoint (otherwise it stays open). Leave blank for zero-config local dev.
INGEST_SECRET=
